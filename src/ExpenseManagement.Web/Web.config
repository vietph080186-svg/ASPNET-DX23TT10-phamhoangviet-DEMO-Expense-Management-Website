<?xml version="1.0" encoding="utf-8"?>
<configuration>
<connectionStrings>
  <add name="PersonalFinanceDB" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=PersonalFinanceDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
</connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <authentication mode="Windows" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
